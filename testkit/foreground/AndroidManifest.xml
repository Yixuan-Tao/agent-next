<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="agent.foreground.test" android:versionCode="1" android:versionName="0.1">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />
    <application android:label="前台隔离测试" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".TestActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".StateProvider" android:authorities="agent.foreground.test.state"
            android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
